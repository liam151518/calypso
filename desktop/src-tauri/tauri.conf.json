{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Calypso",
  "version": "0.1.0",
  "identifier": "dev.calypso.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://localhost:5173",
    "frontendDist": "../web/dist"
  },
  "app": {
    "windows": [
      {
        "title": "Calypso",
        "width": 1280,
        "height": 800,
        "minWidth": 960,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false,
        "decorations": true,
        "transparent": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": [
      "binaries/calypso-sidecar"
    ],
    "resources": [],
    "copyright": "",
    "category": "DeveloperTool",
    "shortDescription": "Local-first marketing platform",
    "longDescription": "Calypso is an open-source, MIT-licensed, downloadable marketing platform. Generate video and image media, run pipelines, schedule social posts, and send email. All from a single desktop app that runs entirely on your machine."
  },
  "plugins": {}
}
