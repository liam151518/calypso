# Gatcha Kingdom ad pipeline — environment variables
# Copy this to .env and fill in the values. .env is gitignored.
#
# Where to get each value: see docs/accounts.md

# ---------- Tier 1: instant accounts ----------

# MiniMax platform (https://platform.minimax.io)
# Used for: MiniMax H3 video generation (cloud primary tier)
MINIMAX_API_TOKEN=

# fal.ai (https://fal.ai)
# Used for: H3 Max speed tier + Kling 2.6 Pro hero tier
FAL_API_KEY=

# Telegram bot (via @BotFather)
# Used for: approval gate — every post sends here for Approve/Regenerate/Skip
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Cloudflare R2 (https://dash.cloudflare.com)
# Used for: reference library backups (Folder A)
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_R2_ACCESS_KEY=
CLOUDFLARE_R2_SECRET_KEY=
CLOUDFLARE_R2_ENDPOINT=

# ElevenLabs (https://elevenlabs.io)
# Used for: UGC voiceover only (most audio comes from H3 native)
ELEVENLABS_API_KEY=

# ---------- Tier 2: platform approval accounts ----------

# X (Twitter) developer account (https://developer.twitter.com)
X_API_KEY=
X_API_SECRET=
X_BEARER_TOKEN=
X_ACCESS_TOKEN=
X_ACCESS_SECRET=

# Meta Graph API (https://developers.facebook.com/apps) — Instagram publishing
META_APP_ID=
META_APP_SECRET=
META_ACCESS_TOKEN=
META_IG_BUSINESS_ID=

# TikTok for Developers (https://developers.tiktok.com)
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_ACCESS_TOKEN=
TIKTOK_OPEN_ID=

# ---------- Local infrastructure ----------

# ComfyUI URL (on the Windows PC, accessible from the Mac via LAN)
COMFYUI_URL=http://localhost:8188

# n8n URL
N8N_URL=http://localhost:5678

# Social Stats URL (port varies by its docker-compose)
SOCIAL_STATS_URL=http://localhost:3000

# Timezone for cron jobs (Africa/Johannesburg for South Africa)
TZ=Africa/Johannesburg

# ---------- Cost cap ----------

# Monthly hard cap on cloud generation spend. Default $30.
# Router falls back to LTX 2.0 ($0.04/s) at 80% of cap, pauses at 95%.
MONTHLY_COST_CAP_USD=30
