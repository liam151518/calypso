{
  "name": "Sale Blast",
  "category": "sale",
  "aspect_ratio": "4:5",
  "canvas": { "width": 1080, "height": 1350 },
  "safe_zones": { "top": 8, "bottom": 16, "left": 6, "right": 6 },
  "default_filter": "neon",
  "brand_locks": ["logo_wm", "percent_strip"],
  "layers": [
    {
      "id": "stripes",
      "type": "shape",
      "name": "Diagonal stripe background",
      "visible": true,
      "locked": false,
      "x": 0, "y": 0, "width": 100, "height": 100,
      "config": {
        "shape_type": "rectangle",
        "fill_color": "{{brand.colors.primary}}"
      }
    },
    {
      "id": "product",
      "type": "product_cutout",
      "name": "Hero product",
      "visible": true,
      "locked": false,
      "x": 28, "y": 22, "width": 44, "height": 44,
      "config": {
        "slot": "center",
        "auto_cutout": true,
        "shadow": true,
        "shadow_color": "#000000",
        "shadow_blur": 22,
        "shadow_offset_x": 0,
        "shadow_offset_y": 10,
        "max_width_percent": 44
      }
    },
    {
      "id": "percent_strip",
      "type": "shape",
      "name": "Percent strip",
      "visible": true,
      "locked": true,
      "x": 0, "y": 72, "width": 100, "height": 14,
      "config": {
        "shape_type": "rectangle",
        "fill_color": "#000000"
      }
    },
    {
      "id": "percent",
      "type": "text",
      "name": "Percent",
      "visible": true,
      "locked": false,
      "x": 0, "y": 72, "width": 100, "height": 14,
      "config": {
        "content": "UP TO 50% OFF",
        "font_family": "Inter",
        "font_size": 64,
        "font_weight": "bold",
        "color": "#ff6a1f",
        "text_align": "center",
        "text_transform": "uppercase",
        "letter_spacing": 8
      }
    },
    {
      "id": "price",
      "type": "text",
      "name": "Price",
      "visible": true,
      "locked": false,
      "x": 6, "y": 90, "width": 88, "height": 6,
      "config": {
        "content": "{{product.name}} from R{{product.price}}",
        "font_family": "Inter",
        "font_size": 24,
        "color": "#f0ece4",
        "text_align": "center"
      }
    },
    {
      "id": "logo_wm",
      "type": "image",
      "name": "Brand watermark",
      "visible": true,
      "locked": true,
      "x": 4, "y": 6, "width": 14, "height": 7,
      "opacity": 0.85,
      "config": {
        "src": "{{brand.logo}}",
        "object_fit": "contain"
      }
    }
  ]
}
