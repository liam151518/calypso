{
  "name": "Announcement",
  "category": "announcement",
  "aspect_ratio": "16:9",
  "canvas": { "width": 1920, "height": 1080 },
  "safe_zones": { "top": 4, "bottom": 12, "left": 4, "right": 4 },
  "default_filter": "bright",
  "brand_locks": ["logo_wm", "cta_button"],
  "layers": [
    {
      "id": "bg",
      "type": "ai_background",
      "name": "Bright announcement backdrop",
      "visible": true,
      "locked": false,
      "x": 0, "y": 0, "width": 100, "height": 100,
      "opacity": 1.0,
      "config": {
        "prompt": "Clean modern banner backdrop, soft brand-tinted gradient, subtle paper texture, airy cinematic light",
        "negative_prompt": "busy, cluttered, dark",
        "model": "flux-pro/v1.1"
      }
    },
    {
      "id": "split_left",
      "type": "shape",
      "name": "Left colour block",
      "visible": true,
      "locked": false,
      "x": 0, "y": 0, "width": 38, "height": 100,
      "config": {
        "shape_type": "rectangle",
        "fill_color": "{{brand.colors.primary}}"
      }
    },
    {
      "id": "product",
      "type": "product_cutout",
      "name": "Hero product",
      "visible": true,
      "locked": false,
      "x": 6, "y": 25, "width": 28, "height": 50,
      "config": {
        "slot": "center",
        "auto_cutout": true,
        "shadow": true,
        "shadow_color": "#000000",
        "shadow_blur": 24,
        "shadow_offset_x": 4,
        "shadow_offset_y": 8,
        "max_width_percent": 28
      }
    },
    {
      "id": "headline",
      "type": "text",
      "name": "Headline",
      "visible": true,
      "locked": false,
      "x": 42, "y": 24, "width": 52, "height": 14,
      "config": {
        "content": "{{product.name}}",
        "font_family": "Inter",
        "font_size": 64,
        "font_weight": "bold",
        "color": "#f0ece4",
        "text_align": "left",
        "line_height": 1.1
      }
    },
    {
      "id": "body",
      "type": "text",
      "name": "Body copy",
      "visible": true,
      "locked": false,
      "x": 42, "y": 50, "width": 52, "height": 22,
      "config": {
        "content": "{{brand.voice.description}}",
        "font_family": "Inter",
        "font_size": 24,
        "color": "#c8c4be",
        "text_align": "left",
        "line_height": 1.4
      }
    },
    {
      "id": "cta_button",
      "type": "shape",
      "name": "CTA button background",
      "visible": true,
      "locked": true,
      "x": 42, "y": 80, "width": 22, "height": 10,
      "config": {
        "shape_type": "rectangle",
        "fill_color": "{{brand.colors.primary}}"
      }
    },
    {
      "id": "cta_label",
      "type": "text",
      "name": "CTA label",
      "visible": true,
      "locked": false,
      "x": 42, "y": 80, "width": 22, "height": 10,
      "config": {
        "content": "Shop now",
        "font_family": "Inter",
        "font_size": 22,
        "font_weight": "bold",
        "color": "#0d0d10",
        "text_align": "center",
        "text_transform": "uppercase",
        "letter_spacing": 2
      }
    },
    {
      "id": "logo_wm",
      "type": "image",
      "name": "Brand watermark",
      "visible": true,
      "locked": true,
      "x": 4, "y": 4, "width": 8, "height": 5,
      "opacity": 0.85,
      "config": {
        "src": "{{brand.logo}}",
        "object_fit": "contain"
      }
    }
  ]
}
