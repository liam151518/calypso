{
  "name": "UGC Raw",
  "category": "ugc",
  "aspect_ratio": "9:16",
  "canvas": { "width": 1080, "height": 1920 },
  "safe_zones": { "top": 14, "bottom": 24, "left": 4, "right": 4 },
  "default_filter": "minimal",
  "brand_locks": ["logo_wm"],
  "layers": [
    {
      "id": "bg",
      "type": "video_background",
      "name": "Phone-cam backdrop",
      "visible": true,
      "locked": false,
      "x": 0, "y": 0, "width": 100, "height": 100,
      "opacity": 1.0,
      "config": {
        "prompt": "Casual handheld phone video, room light, product unboxing vibe, cinematic grain, social-native feel",
        "model": "fal_video",
        "duration": 8,
        "loop": true
      }
    },
    {
      "id": "product",
      "type": "product_cutout",
      "name": "Hero product",
      "visible": true,
      "locked": false,
      "x": 18, "y": 28, "width": 64, "height": 36,
      "config": {
        "slot": "center",
        "auto_cutout": true,
        "shadow": true,
        "shadow_color": "#000000",
        "shadow_blur": 16,
        "shadow_offset_x": 0,
        "shadow_offset_y": 6,
        "max_width_percent": 64
      }
    },
    {
      "id": "reaction",
      "type": "text",
      "name": "Reaction overlay",
      "visible": true,
      "locked": false,
      "x": 6, "y": 8, "width": 88, "height": 10,
      "config": {
        "content": "Unboxing: {{product.name}}",
        "font_family": "Inter",
        "font_size": 48,
        "font_weight": "bold",
        "color": "#ffffff",
        "text_align": "center",
        "text_shadow": {
          "color": "#000000",
          "blur": 8,
          "offset_x": 0,
          "offset_y": 2
        }
      }
    },
    {
      "id": "logo_wm",
      "type": "image",
      "name": "Brand watermark",
      "visible": true,
      "locked": true,
      "x": 78, "y": 88, "width": 16, "height": 6,
      "opacity": 0.7,
      "config": {
        "src": "{{brand.logo}}",
        "object_fit": "contain"
      }
    }
  ]
}
